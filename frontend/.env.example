# frontend/.env.example
# 실제 값은 .env(또는 .env.local)에 넣고 커밋하지 않는다.
# Vite는 VITE_ 접두사가 붙은 변수만 클라이언트에 노출한다.

# 백엔드 API 베이스 URL (기본값: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# 카카오 로그인 (카카오 개발자 콘솔)
# VITE_KAKAO_CLIENT_ID: REST API 키
# VITE_KAKAO_REDIRECT_URI: 카카오 콘솔에 등록한 Redirect URI와 정확히 일치해야 함
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/callback
