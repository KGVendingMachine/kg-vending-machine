# backend/.env.example
# 실제 값은 .env 파일에 넣고, .env는 절대 커밋하지 않는다.
# 필드 설명: docs/configuration.md 참고

PROJECT_NAME=KG Vending Machine
API_PREFIX=/api
ENVIRONMENT=local
DEBUG=true

CORS_ORIGINS=["http://localhost:5173"]

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kg_vending

# 기업마당(BizInfo) API - OCR/크롤링 담당
BIZINFO_API_KEY=
BIZINFO_API_URL=https://www.bizinfo.go.kr/uss/rss/bizinfoApi.do
BIZINFO_PAGE_SIZE=100
BIZINFO_REQUEST_TIMEOUT_SECONDS=15
BIZINFO_MAX_RETRIES=3

# K-Startup API - OCR/크롤링 담당
KSTARTUP_API_KEY=
KSTARTUP_API_URL=https://apis.data.go.kr/B552735/kisedKstartupService01/getAnnouncementInformation01
KSTARTUP_PAGE_SIZE=100
KSTARTUP_REQUEST_TIMEOUT_SECONDS=15
KSTARTUP_MAX_RETRIES=3

# 파일 업로드/OCR 판별 기준 - Backend/OCR 공용
STORAGE_ROOT=storage/uploads
MAX_UPLOAD_SIZE_BYTES=52428800
PDF_OCR_TEXT_THRESHOLD=50
PPTX_OCR_TEXT_THRESHOLD=20

# Naver CLOVA OCR - OCR/크롤링 담당
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET_KEY=
CLOVA_OCR_TIMEOUT_SECONDS=30
CLOVA_OCR_MAX_RETRIES=3
CLOVA_OCR_LANGUAGE=ko
CLOVA_OCR_ENABLE_TABLE_DETECTION=false
CLOVA_OCR_PDF_DPI=300
CLOVA_OCR_PREPROCESS_IMAGES=true
CLOVA_OCR_BLUR_THRESHOLD=80
CLOVA_OCR_TARGET_LONG_SIDE=1960
